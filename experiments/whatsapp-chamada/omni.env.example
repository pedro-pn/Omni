# Configuração da integração nativa de DESENVOLVIMENTO.
# Salvar como .env.omni (0600). As duas KEY abaixo precisam ter o mesmo valor
# aleatório (openssl rand -hex 32). Nunca usar a chave da ponte como chave do app.
CHAMADA_OMNI=on
CHAMADA_MODO=simulado
CHAMADA_CONEXAO=propria
CHAMADA_ESCUTAR=127.0.0.1:8098
CHAMADA_OMNI_KEY=
CHAMADA_OMNI_ORIGIN=http://localhost:3001
CHAMADA_OMNI_EVENTOS=http://127.0.0.1:3001/api/chamadas/eventos
CHAMADA_NUMEROS_TESTE=5511999990000
CHAMADA_RETENCAO_HORAS=24
CHAMADA_LIMITE_SEGUNDOS=600
CHAMADA_PONTE_URL=ws://127.0.0.1:8097/v1/calls
CHAMADA_PONTE_TOKEN=
CHAMADAS_HABILITADAS=on
CHAMADAS_SERVICO_URL=http://127.0.0.1:8098
CHAMADAS_SERVICO_KEY=
APP_ORIGIN=http://localhost:3001
# Apenas para a extensão multi-linha da Evolution no modo teste real:
OMNI_CHAMADA_PONTE=omni
