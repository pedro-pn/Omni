# Somente o ambiente desta POC. Não copie o .env do Omni nem chaves de produção.
CHAMADA_MODO=simulado
CHAMADA_ESCUTAR=127.0.0.1:8096
CHAMADA_DADOS=data
CHAMADA_LIMITE_SEGUNDOS=600
CHAMADA_RETENCAO_HORAS=24

# Para chamadas reais: modo teste, a linha pareada e os destinos permitidos.
# DDI + DDD + número, somente dígitos. Use aparelhos controlados pela equipe.
CHAMADA_LINHA_TESTE=
CHAMADA_NUMEROS_TESTE=

# propria: QR da POC (padrão). evolution: reutiliza o pareamento pela ponte local.
CHAMADA_CONEXAO=propria
CHAMADA_PONTE_URL=
CHAMADA_PONTE_TOKEN=

# Diagnóstico opcional: só faz GET na Evolution de teste.
CHAMADA_EVOLUTION_URL=
CHAMADA_EVOLUTION_KEY=
CHAMADA_EVOLUTION_INSTANCIA=
