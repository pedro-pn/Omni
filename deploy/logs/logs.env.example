# Copie para deploy/logs/.env na VPS (fora do git; chmod 600) e preencha.
# Os três valores vêm do Grafana Cloud (o mesmo do filtroAPP): Connections > Hosted logs.
# Não rode o comando de instalação que o Grafana mostra (ele instala o agente no host).

# Deve terminar em /loki/api/v1/push.
GRAFANA_LOGS_URL=https://logs-prod-000.grafana.net/loki/api/v1/push
# Número do usuário dos logs.
GRAFANA_LOGS_USER=000000
# Token só com o escopo logs:write, próprio do Omni (começa com glc_).
GRAFANA_LOGS_TOKEN=
# Rótulo "host" nas buscas.
LOGS_HOST=vps-filtrovali
