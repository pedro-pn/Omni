# Modelo do deploy/.env.staging (copie, preencha na VPS e NUNCA versione o arquivo preenchido).
# Gere cada segredo com:  openssl rand -hex 32   (valores diferentes para cada linha)
# Passo a passo: docs/producao/deploy.md

# ---- Ambiente
OMNI_AMBIENTE=staging
APP_ORIGIN=https://omnistaging.filtrovali.com.br
OMNI_WEB_PORT=8085

# ---- Banco (senhas novas, só deste ambiente)
POSTGRES_PASSWORD=
OMNI_OWNER_PASSWORD=
OMNI_APP_PASSWORD=
OMNI_WORKER_PASSWORD=
AUTH_SECRET=

# ---- Login Microsoft (app "Omni" no Entra; acrescentar a URI https://omnistaging.filtrovali.com.br/auth/callback)
# Obrigatório: sem os três valores o web não sobe (é o único jeito de entrar fora do desenvolvimento).
ENTRA_LOGIN_ENABLED=on
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---- filtroAPP: em staging, nada grava de verdade (a validação recusa "real" contra a produção do filtroAPP)
FILTROAPP_API_URL=https://app.filtrovali.com.br/api/integracoes/v1
FILTROAPP_API_TOKEN=
FILTROAPP_ESCRITA=simulada

# ---- Prisma CRM: só o sandbox fora da produção
PRISMA_OMNI_ENVIRONMENT=sandbox
PRISMA_OMNI_READER_TOKEN=

# ---- Microsoft Graph (app "Omni – Integrações"): as QUATRO juntas ou nenhuma (sem elas, e-mails/SharePoint/Teams ficam desligados)
# Certificado em deploy/secrets/omni-graph.key → GRAPH_PRIVATE_KEY_PATH=/run/secrets/omni/omni-graph.key
OMNI_SECRETS_DIR=./secrets
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_PRIVATE_KEY_PATH=
GRAPH_CERT_SHA256_THUMBPRINT=
# Gravações das ligações no SharePoint: biblioteca Documentos do site OmniAnexos (não é segredo; docs/integracoes/sharepoint-site-anexos.md)
GRAPH_ANEXOS_DRIVE_ID=
# Chave mestra das gravações cifradas no SharePoint (openssl rand -hex 32; só deste ambiente).
# GUARDE UMA CÓPIA FORA DA VPS (cofre da TI): sem ela, nenhuma gravação pode ser ouvida. Nunca troque sem migrar.
GRAVACOES_CHAVE_MESTRA=
EMAIL_ENVIO=ensaio
# Remetente dos avisos das tarefas por e-mail (staging: ensaio, não envia)
EMAIL_AVISOS_REMETENTE=

# ---- IA (OpenAI, organização com retenção zero)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRICAO_MODEL=gpt-4o-transcribe
IA_LEITURA_RDO=ligada
IA_RESUMO_REUNIAO=ligada
IA_ALERTAS=ligada
# O staging não confere o backup (o status é o da produção).
OPERACAO_STATUS=desligado
IA_ASSINATURAS=ligada
# As chamadas do WhatsApp não estão no deploy (só no desenvolvimento): deixe desligada
IA_RESUMO_CHAMADA=desligada

# ---- Notificações no celular (chaves VAPID só deste ambiente: npx web-push generate-vapid-keys)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://omnistaging.filtrovali.com.br

# ---- WhatsApp (perfil "whatsapp" do compose): Evolution própria deste ambiente
WHATSAPP_EVOLUTION_URL=http://evolution:8080
WHATSAPP_EVOLUTION_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_URL=http://web:3000/api/whatsapp/webhook
EVOLUTION_POSTGRES_PASSWORD=
WHATSAPP_ENVIO=ensaio

# Agenda das tarefas por link (.ics): gere uma (openssl rand -hex 32). Na produção, a mesma do Foco.
APPLE_CALENDAR_SIGNING_KEY=

# ---- Chamadas pessoais do WhatsApp (perfis "whatsapp" + "chamadas"): no staging, só com os números da equipe
CHAMADAS_HABILITADAS=on
CHAMADAS_SERVICO_URL=http://voz:8098
CHAMADAS_SERVICO_KEY=
CHAMADA_PONTE_TOKEN=
# teste + omni: só liga e atende os números de CHAMADA_NUMEROS_TESTE (DDI+DDD+número, separados por vírgula)
CHAMADA_MODO=teste
CHAMADA_PONTE=omni
CHAMADA_NUMEROS_TESTE=
# 8087 já é usada por outro serviço da VPS
OMNI_AUDIO_PORT=8088

# Teto diário da IA (E11): passou, nenhuma chamada ao modelo sai até a meia-noite (Brasília).
# Uso medido em 11/2026: até 140 mil tokens num dia de carga retroativa. 0 desliga o critério.
IA_TETO_TOKENS_DIA=2000000
IA_TETO_CHAMADAS_DIA=3000
