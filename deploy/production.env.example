# Modelo do deploy/.env.production (copie, preencha na VPS e NUNCA versione o arquivo preenchido).
# Gere cada segredo com:  openssl rand -hex 32   (um valor diferente por linha; nunca os do desenvolvimento ou do staging)
# Guia completo: docs/producao/guia-producao.md

# ---- Ambiente
OMNI_AMBIENTE=producao
APP_ORIGIN=https://omni.filtrovali.com.br
OMNI_WEB_PORT=8084

# ---- Banco (senhas novas, só da produção)
POSTGRES_PASSWORD=
OMNI_OWNER_PASSWORD=
OMNI_APP_PASSWORD=
OMNI_WORKER_PASSWORD=
AUTH_SECRET=

# ---- Login Microsoft (app "Omni" no Entra, URI https://omni.filtrovali.com.br/auth/callback)
# Segredo do cliente OU certificado (ENTRA_PRIVATE_KEY_PATH + ENTRA_CERT_SHA256_THUMBPRINT).
ENTRA_LOGIN_ENABLED=on
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_PRIVATE_KEY_PATH=
ENTRA_CERT_SHA256_THUMBPRINT=

# ---- filtroAPP: token "Omni – produção" (escopos em docs/integracoes/filtroapp-token.md). Worker e web usam o mesmo.
FILTROAPP_API_URL=https://app.filtrovali.com.br/api/integracoes/v1
FILTROAPP_API_TOKEN=
# desligada → real só depois de conferir os escopos de escrita (desvios à Qualidade, descargas)
FILTROAPP_ESCRITA=desligada

# ---- Prisma CRM: produção da API do Omni ativada no Prisma (infra/omni/README.md do Prisma)
PRISMA_OMNI_ENVIRONMENT=production
PRISMA_OMNI_READER_TOKEN=

# ---- Microsoft Graph (app "Omni – Integrações"): as QUATRO juntas ou nenhuma
# Certificado em deploy/secrets/omni-graph.key → GRAPH_PRIVATE_KEY_PATH=/run/secrets/omni/omni-graph.key
OMNI_SECRETS_DIR=./secrets
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_PRIVATE_KEY_PATH=/run/secrets/omni/omni-graph.key
GRAPH_CERT_SHA256_THUMBPRINT=
# Gravações das ligações no SharePoint: biblioteca Documentos do site OmniAnexos (não é segredo; docs/integracoes/sharepoint-site-anexos.md)
GRAPH_ANEXOS_DRIVE_ID=
# Chave mestra das gravações cifradas no SharePoint (openssl rand -hex 32; só deste ambiente).
# GUARDE UMA CÓPIA FORA DA VPS (cofre da TI): sem ela, nenhuma gravação pode ser ouvida. Nunca troque sem migrar.
GRAVACOES_CHAVE_MESTRA=
# ensaio → real depois do comunicado ao time (LGPD)
EMAIL_ENVIO=ensaio
# Caixa remetente dos avisos das tarefas (ex.: omni@filtrovali.com.br), no grupo "Omni - Caixas"
EMAIL_AVISOS_REMETENTE=

# ---- IA (OpenAI, organização com retenção zero). Ligar cada uma depois do comunicado ao time.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRICAO_MODEL=gpt-4o-transcribe
IA_LEITURA_RDO=desligada
IA_RESUMO_REUNIAO=desligada
IA_ALERTAS=desligada
# Retenção (sessões, avisos, logs técnicos, downloads, IP do termo): ensaio só conta; real apaga
RETENCAO=ensaio
# E-mail novo na hora pelo aviso do Graph (precisa do APP_ORIGIN público): desligado | ligado
EMAIL_AVISO_IMEDIATO=desligado
IA_ASSINATURAS=desligada
# Resumo das ligações gravadas (só quando o dono pede); precisa das chamadas abaixo
IA_RESUMO_CHAMADA=desligada

# ---- Notificações no celular: chaves VAPID só da produção (npx web-push generate-vapid-keys)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://omni.filtrovali.com.br

# ---- WhatsApp (perfil "whatsapp" do compose): Evolution própria da produção
WHATSAPP_EVOLUTION_URL=http://evolution:8080
WHATSAPP_EVOLUTION_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_URL=http://web:3000/api/whatsapp/webhook
EVOLUTION_POSTGRES_PASSWORD=
# ensaio → real depois do comunicado ao time (LGPD)
WHATSAPP_ENVIO=ensaio

# ---- Chamadas pessoais do WhatsApp (perfis "whatsapp" + "chamadas" do compose)
# Duas chaves novas e diferentes (openssl rand -hex 32): a do serviço de voz (web/worker) e a da ponte na Evolution.
CHAMADAS_HABILITADAS=on
CHAMADAS_SERVICO_URL=http://voz:8098
CHAMADAS_SERVICO_KEY=
CHAMADA_PONTE_TOKEN=
# producao + producao: cada pessoa liga e atende qualquer contato pelo próprio número
CHAMADA_MODO=producao
CHAMADA_PONTE=producao
# Porta do áudio para o Caddy (/omni/audio): 8086 na produção
OMNI_AUDIO_PORT=8086
# Limite por ligação em segundos (padrão 3600, máx. 14400) e retenção das gravações em horas (padrão 43800 = 5 anos, máx. 87600)
CHAMADA_LIMITE_SEGUNDOS=
CHAMADA_RETENCAO_HORAS=

# ---- Agenda das tarefas por link (.ics): a MESMA chave do Foco, para os links já assinados continuarem valendo
APPLE_CALENDAR_SIGNING_KEY=
