# Blocos para o Caddyfile persistente do proxy compartilhado
# (filtroAPP-main/deploy/infra-proxy). Publicar o DNS antes de adicionar cada bloco.
# Passo a passo: docs/producao/deploy.md.

# Página de manutenção do Omni (E24): quando o web não responde (publicação, volta de versão,
# processo parado ou deploy/manutencao.sh on), o Caddy devolve 503 com esta página, sem nada de fora.
# Na API, JSON. Fonte: deploy/caddy/omni.caddy no repositório do Omni (o teste
# apps/web/src/server/manutencao.test.ts confere); copie igual para o Caddyfile do infra-proxy.
(omni_manutencao) {
	# Sem códigos no handle_errors: no Caddy 2.8, com códigos ele descarta os matchers de dentro.
	handle_errors {
		@omni_api expression `{err.status_code} in [502, 503, 504] && path('/api/*')`
		@omni_pagina expression `{err.status_code} in [502, 503, 504] && !path('/api/*')`
		handle @omni_api {
			header Retry-After 30
			header Cache-Control no-store
			header Content-Type "application/json; charset=utf-8"
			respond `{"erro":"manutencao","mensagem":"O Omni está em manutenção. Tente de novo em instantes."}` 503
		}
		handle @omni_pagina {
			header Retry-After 30
			header Cache-Control no-store
			header Content-Type "text/html; charset=utf-8"
			respond <<HTML
		<!doctype html>
		<html lang="pt-BR">
		<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<meta http-equiv="refresh" content="30">
		<meta name="robots" content="noindex">
		<title>Omni em manutenção</title>
		<style>
		:root{--fundo:#e8e8e8;--superficie:#fff;--ink:#1b211d;--muted:#5f6661;--linha:#dcdcdc;--floresta:#30503a;color-scheme:light dark}
		@media (prefers-color-scheme:dark){:root{--fundo:#0f1210;--superficie:#171b18;--ink:#e8e8e8;--muted:#a0a7a2;--linha:#2c332e;--floresta:#8fbf9d}}
		*{box-sizing:border-box}
		body{margin:0;min-height:100vh;display:grid;place-items:center;padding:16px;background:var(--fundo);color:var(--ink);font-family:Poppins,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
		main{max-width:440px;width:100%;background:var(--superficie);border:1px solid var(--linha);border-radius:12px;padding:32px 24px;text-align:center}
		img{width:64px;height:64px;border-radius:14px}
		h1{font-size:1.25rem;margin:16px 0 8px;color:var(--floresta)}
		p{margin:8px 0;line-height:1.5;color:var(--muted)}
		</style>
		</head>
		<body>
		<main>
		<img src="data:image/png;base64," alt="Omni">
		<h1>O Omni está em manutenção</h1>
		<p>Estamos atualizando o sistema. Ele volta em instantes.</p>
		<p>Esta página tenta de novo sozinha a cada 30 segundos.</p>
		</main>
		</body>
		</html>
		HTML 503
		}
	}
}

# --- Omni (staging; Docker publica em 172.17.0.1:8085) ----------------------
omnistaging.filtrovali.com.br {
	encode zstd gzip
	import omni_manutencao
	# Rotas chamadas só pela rede interna do Docker (http://web:3000): fechadas para a internet.
	# Lista em apps/web/src/server/rotas-publicas.ts (exposicao "interna").
	@interno path /api/whatsapp/webhook /api/chamadas/eventos
	handle @interno {
		respond 404
	}
	# Áudio das chamadas (WebSocket) direto no serviço de voz; só este caminho (porta 8087).
	handle /omni/audio {
		reverse_proxy host.docker.internal:8087
	}
	handle {
		reverse_proxy host.docker.internal:8085
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

# --- Omni (produção; Docker publica em 172.17.0.1:8084) ---------------------
omni.filtrovali.com.br {
	encode zstd gzip
	import omni_manutencao
	# Rotas chamadas só pela rede interna do Docker (http://web:3000): fechadas para a internet.
	# Lista em apps/web/src/server/rotas-publicas.ts (exposicao "interna").
	@interno path /api/whatsapp/webhook /api/chamadas/eventos
	handle @interno {
		respond 404
	}
	# Áudio das chamadas (WebSocket) direto no serviço de voz; só este caminho (porta 8086).
	handle /omni/audio {
		reverse_proxy host.docker.internal:8086
	}
	handle {
		reverse_proxy host.docker.internal:8084
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

