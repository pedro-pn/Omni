# Blocos para o Caddyfile persistente do proxy compartilhado
# (filtroAPP-main/deploy/infra-proxy). Publicar o DNS antes de adicionar cada bloco.
# Passo a passo: docs/producao/deploy.md.

# --- Omni (staging; Docker publica em 172.17.0.1:8085) ----------------------
omnistaging.filtrovali.com.br {
	encode zstd gzip
	# Rotas chamadas só pela rede interna do Docker (http://web:3000): fechadas para a internet.
	# Lista em apps/web/src/server/rotas-publicas.ts (exposicao "interna").
	@interno path /api/whatsapp/webhook /api/chamadas/eventos
	handle @interno {
		respond 404
	}
	# Áudio das chamadas (WebSocket) direto no serviço de voz; só este caminho (porta 8088).
	handle /omni/audio {
		reverse_proxy host.docker.internal:8088
	}
	handle {
		reverse_proxy host.docker.internal:8085
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

# --- Omni (produção; Docker publica em 172.17.0.1:8084) ---------------------
omni.filtrovali.com.br {
	encode zstd gzip
	# Rotas chamadas só pela rede interna do Docker (http://web:3000): fechadas para a internet.
	# Lista em apps/web/src/server/rotas-publicas.ts (exposicao "interna").
	@interno path /api/whatsapp/webhook /api/chamadas/eventos
	handle @interno {
		respond 404
	}
	# Áudio das chamadas (WebSocket) direto no serviço de voz; só este caminho (porta 8086).
	handle /omni/audio {
		reverse_proxy host.docker.internal:8086
	}
	handle {
		reverse_proxy host.docker.internal:8084
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

