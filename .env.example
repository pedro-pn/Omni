# Copie para .env e preencha. Nunca versione o .env.

NODE_ENV=development
APP_ORIGIN=http://localhost:3000
TZ_EMPRESA=America/Sao_Paulo

# Postgres (docker-compose.dev.yml). Três papéis:
#  - omni_owner: dono das tabelas, só para migrations
#  - omni_app: usado pelo web; sujeito a RLS
#  - omni_worker: usado pelo worker
DATABASE_URL_OWNER=postgres://omni_owner:omni_owner_dev@localhost:5433/omni
DATABASE_URL_APP=postgres://omni_app:omni_app_dev@localhost:5433/omni
DATABASE_URL_WORKER=postgres://omni_worker:omni_worker_dev@localhost:5433/omni

# Segredo para cifrar o cookie do fluxo de login (mín. 32 caracteres aleatórios)
AUTH_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Login Microsoft Entra ID (app do Omni, tenant único, atribuição obrigatória)
ENTRA_LOGIN_ENABLED=off
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Use certificado (produção) OU segredo (homologação), nunca os dois
ENTRA_PRIVATE_KEY_PATH=
ENTRA_CERT_SHA256_THUMBPRINT=
ENTRA_CLIENT_SECRET=

# Microsoft Graph — app "Omni – Integrações" (Fase 4; docs/integracoes/m365-registro.md).
# Separado do login. Certificado em produção; nunca versionar a chave.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_PRIVATE_KEY_PATH=
GRAPH_CERT_SHA256_THUMBPRINT=
# Envio de e-mail pelo Omni: desligado | ensaio (monta e registra, não envia) | real (recusado fora da produção)
EMAIL_ENVIO=ensaio
# Avisos das tarefas por e-mail e resumo semanal (worker): caixa remetente no grupo "Omni - Caixas".
# Sem ela, ou fora da produção, os e-mails são montados e registrados em notification_emails (ensaio).
EMAIL_AVISOS_REMETENTE=
# Biblioteca do site dos anexos do Omni/Foco (escrita só nele; docs/integracoes/sharepoint-site-anexos.md)
GRAPH_ANEXOS_DRIVE_ID=

# Só em desenvolvimento: entra com um e-mail sem Microsoft. Proibido em produção.
AUTH_DEV_LOGIN=on

# API de integrações do filtroAPP (somente leitura, token criado em
# filtroAPP → Administração → Tokens de API). O segredo aparece uma vez só.
FILTROAPP_API_URL=https://app.filtrovali.com.br/api/integracoes/v1
FILTROAPP_API_TOKEN=

# Prisma CRM (contrato docs/prisma-omni.md do CRM). sandbox até a homologação.
PRISMA_BASE_URL=https://prismacrm.filtrovali.com.br
PRISMA_OMNI_ENVIRONMENT=sandbox
# Token `reader` da aplicação: só no servidor (worker). Escritas usam a conexão individual (PKCE).
PRISMA_OMNI_READER_TOKEN=

# Toda escrita do Omni no filtroAPP (desvios da IA e as próximas):
#   desligada → não chama o filtroAPP; registra e avisa só no Omni (padrão)
#   simulada  → o filtroAPP valida com os dados reais e NÃO grava (Prefer: validate-only)
#   real      → grava. Fora da produção do Omni é recusado contra app.filtrovali.com.br.
FILTROAPP_ESCRITA=desligada

# IA v2 (Fase 8, ADR 0005): API da OpenAI; modelos por variável, escolhidos pelo conjunto de avaliação
OPENAI_API_KEY=
# Leitura dos RDOs pelo LLM (manda o texto do RDO à OpenAI): desligada | ligada
IA_LEITURA_RDO=desligada
# Resumo das reuniões do Teams ligadas à missão (transcrição → resumo no Gerencial). desligada | ligada
IA_RESUMO_REUNIAO=desligada
# Resumo das ligações gravadas (transcrição e resumo na OpenAI; a transcrição não é guardada).
# O worker usa CHAMADAS_SERVICO_URL e CHAMADAS_SERVICO_KEY (os mesmos do web) para buscar o áudio.
IA_RESUMO_CHAMADA=desligada
# Nome, cargo e empresa dos participantes pela assinatura dos e-mails (worker, precisa do Graph).
IA_ASSINATURAS=desligada
OPENAI_TRANSCRICAO_MODEL=gpt-4o-transcribe
OPENAI_MODEL=gpt-6-luna

# WhatsApp pela Evolution própria do Omni (ADR 0004; docs/integracoes/whatsapp-evolution.md).
# Desenvolvimento: `npm run whatsapp:up`. Chave e segredo diferentes: openssl rand -hex 32.
WHATSAPP_EVOLUTION_URL=http://127.0.0.1:8085
WHATSAPP_EVOLUTION_KEY=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_URL=http://host.docker.internal:3999/api/whatsapp/webhook
# desligado | ensaio (registra, não envia) | real (recusado fora da produção)
WHATSAPP_ENVIO=ensaio
# Integração nativa de chamadas em desenvolvimento (docs/integracoes/chamadas-omni.md).
CHAMADAS_HABILITADAS=off
CHAMADAS_SERVICO_URL=http://127.0.0.1:8098
CHAMADAS_SERVICO_KEY=
# Alertas pedidos à IA no Interno/Gerencial (@IA, /alerta): o pedido e o texto dos RDOs vão à OpenAI. desligada | ligada
IA_ALERTAS=desligada
# Notificações no celular/computador (Web Push). Gere com: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://omni.filtrovali.com.br

# Ambiente: desenvolvimento | staging | producao (sem valor, o NODE_ENV decide). Staging/produção: docs/producao/deploy.md
# OMNI_AMBIENTE=desenvolvimento

# Agenda das tarefas por link privado (.ics). Na produção, a MESMA chave do Foco
# (APPLE_CALENDAR_SIGNING_KEY, ou a SUPABASE_SERVICE_ROLE_KEY se o Foco não tinha a própria)
# para os links já assinados nos celulares continuarem valendo depois do corte.
APPLE_CALENDAR_SIGNING_KEY=

# Migração do Foco (npm run foco:importar; docs/producao/migracao-foco.md). Só durante a
# migração: leitura do Supabase do Foco com a chave de serviço (o importador só faz GET).
# Apague depois do corte. FOCO_CHAVE_API_TESTE (opcional): uma chave foco_live_… para o
# relatório conferir que ela continua valendo no Omni.
FOCO_SUPABASE_URL=
FOCO_SUPABASE_SERVICE_ROLE_KEY=
FOCO_CHAVE_API_TESTE=
# Sem a chave de serviço (Lovable Cloud): pela função de exportação do Foco
# (docs/integracoes/foco-exportacao.sql), com a chave publicável do front do Foco, o
# segredo da exportação e a pasta do pacote de anexos.
FOCO_SUPABASE_CHAVE_PUBLICA=
FOCO_EXPORT_TOKEN=
FOCO_ANEXOS_PASTA=

# Teto diário da IA (E11): passou, nenhuma chamada ao modelo sai até a meia-noite (Brasília).
# Uso medido em 11/2026: até 140 mil tokens num dia de carga retroativa. 0 desliga o critério.
IA_TETO_TOKENS_DIA=2000000
IA_TETO_CHAMADAS_DIA=3000

# CSP das páginas (E12): "relatorio" (padrão) só relata violações, que viram erros do sistema;
# "aplicar" bloqueia. Passar para "aplicar" depois de alguns dias sem violações legítimas.
CSP_MODO=relatorio
